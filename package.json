{
	"name": "mtx-decompressor",
	"version": "1.8.0",
	"description": "MicroType Express (MTX) font decompressor — extracts TTF/OTF from compressed EOT containers.",
	"homepage": "https://github.com/ChristopherVR/mtx-decompressor",
	"bugs": {
		"url": "https://github.com/ChristopherVR/mtx-decompressor/issues"
	},
	"license": "MPL-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "https://github.com/ChristopherVR/mtx-decompressor.git"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown --config-loader native",
		"dev": "tsdown --config-loader native --watch",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitepress": "^1.6.4",
		"vitest": "^5.0.3",
		"vue": "^3.5.43"
	}
}
